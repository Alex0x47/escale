#!/bin/zsh
set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

fail() {
  echo "error: $*" >&2
  exit 1
}

validate_version() {
  [[ "$1" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] \
    || fail "VERSION must contain a semantic version such as 1.2.3"
}

version="$("$PROJECT_ROOT/scripts/version.sh" current)"
validate_version "$version"
echo "Escale version $version is valid. Release versions are changed explicitly."
